@@ -114,7 +121,20 @@ namespace dsp56k
 	void DmaChannel::setDCR(const TWord _controlRegister)
 	{
 		if(m_dcr == _controlRegister)
+		{
+			// A DCR write with DE=1 while a self-clearing window is still
+			// running RENEWS the enable: at expiry the channel reloads its
+			// countdown and keeps going instead of clearing DE. The address
+			// phase is untouched — the Octatrack's ESAI feed (DCR2=0xCC6220,
+			// dual-counter source wrapping via DOR2) writes this keep-alive
+			// once per audio block, mid-window, and both dropping it (channel
+			// strands disabled, DSP spins on a DSR2 checkpoint forever) and
+			// reinitialising the counters (address phase escapes the ring)
+			// are measurably wrong.
+			if (m_armed && bitvalue(m_dcr, De) && isDEClearedAfterTransfer())
+				m_deRenewed = true;
 			return;
+		}
 
 		// Re-configuration: drop any previous trigger registration and clear the armed flag
 		// so arm() can re-initialize the working counters with the new DCR settings.
@@ -809,8 +829,25 @@ namespace dsp56k
 
 	void DmaChannel::finishTransfer()
 	{
+
 		if(isDEClearedAfterTransfer())
+		{
+			if (m_deRenewed)
+			{
+				// Renewed mid-window (see setDCR): reload the countdown, keep
+				// the address phase, stay armed.
+				m_deRenewed = false;
+				m_dma.removeTriggerTarget(this);
+				m_armed = false;
+				m_dma.clearActiveChannel();
+				const auto dsr = m_dsr, ddr = m_ddr;
+				arm();
+				m_dsr = dsr;
+				m_ddr = ddr;
+				return;
+			}
 			m_dcr &= ~(1 << De);
+		}
 
 		m_dma.clearActiveChannel();
 
