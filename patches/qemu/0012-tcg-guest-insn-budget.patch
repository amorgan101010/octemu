 #include "exec/helper-proto-common.h"
@@ -752,6 +753,25 @@ static inline bool cpu_handle_exception(CPUState *cpu, int *ret)
     return false;
 }
 
+uint32_t ot_insn_budget;
+void (*ot_insn_budget_hook)(void);
+static uint64_t ot_insn_whole_quanta;
+
+uint64_t ot_insn_retired(void)
+{
+    if (!ot_insn_budget) {
+        return 0;
+    }
+    return ot_insn_whole_quanta
+         + (ot_insn_budget - first_cpu->neg.icount_decr.u16.low);
+}
+
+void ot_insn_budget_enable(uint32_t quantum, void (*hook)(void))
+{
+    ot_insn_budget = quantum < TCG_MAX_INSNS ? TCG_MAX_INSNS : quantum;
+    ot_insn_budget_hook = hook;
+}
+
 void tcg_kick_vcpu_thread(CPUState *cpu)
 {
     /*
@@ -908,6 +928,20 @@ static inline void cpu_loop_exec_tb(CPUState *cpu, TranslationBlock *tb,
     }
 
     /* Instruction counter expired.  */
+    if (ot_insn_budget) {
+        /*
+         * The Octatrack guest-instruction budget, not icount. Refill it and
+         * give the other chip the slice of its own time that the guest just
+         * earned. This is a TB boundary on the vCPU thread: CPU state is
+         * consistent and no BQL is held. See exec/ot-insn-budget.h.
+         */
+        ot_insn_whole_quanta += ot_insn_budget;
+        cpu->neg.icount_decr.u16.low = ot_insn_budget;
+        if (ot_insn_budget_hook) {
+            ot_insn_budget_hook();
