diff --git a/include/exec/ot-insn-budget.h b/include/exec/ot-insn-budget.h
new file mode 100644
index 0000000000..47097d70dd
--- /dev/null
+++ b/include/exec/ot-insn-budget.h
@@ -0,0 +1,60 @@
+/*
+ * A GUEST-INSTRUCTION budget, with icount OFF.
+ *
+ * The Octatrack machine hosts a DSP56721 whose time is its own instruction
+ * retirement, next to a ColdFire whose time is QEMU's. On silicon those are
+ * two crystals in a fixed ratio; here nothing ties them, so orderings that
+ * hardware guarantees by a ~100x margin are resolved by a host-scheduler race
+ * between the vCPU thread and a DSP worker thread.
+ *
+ * This is the tie. It is icount's decrementer with icount's clock removed:
+ * every TB subtracts its instruction count from neg.icount_decr.u16.low and
+ * exits the chain when the budget underflows, at which point cpu_loop_exec_tb
+ * refills it and calls a hook. The hook runs on the vCPU thread at a TB
+ * boundary — CPU state consistent, no BQL held — which makes it a safe point
+ * to advance the other chip.
+ *
+ * Why not -icount itself: icount also drives QEMU_CLOCK_VIRTUAL from the
+ * instruction count and then SLEEPS the vCPU to keep the virtual clock from
+ * running ahead of the host. This machine has no throughput to give away to
+ * that, and it does not need device timers to be deterministic — only the DSP
+ * ordering. See SINGLE-THREAD-PLAN.md, Phase 1(b).
+ *
+ * Scope: this fixes DSP <-> ColdFire ordering. It does NOT fix
+ * device-timer <-> ColdFire ordering; with icount off QEMU_CLOCK_VIRTUAL
+ * still tracks host time.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef OT_INSN_BUDGET_H
+#define OT_INSN_BUDGET_H
+
+/* Guest instructions per quantum. ZERO DISABLES EVERYTHING: gen_tb_start then
+ * emits the stock preamble and cpu_loop_exec_tb keeps the stock assert, so an
+ * unconfigured machine is bit-for-bit the upstream code path. */
+extern uint32_t ot_insn_budget;
+extern void (*ot_insn_budget_hook)(void);
+
+/*
+ * Arm the budget. Must be called during machine init, BEFORE the first TB is
+ * translated — the decrementer lives in the TB preamble, so TBs generated
+ * while it was off would never decrement.
+ *
+ * The quantum is clamped up to TCG_MAX_INSNS: a TB may hold that many
+ * instructions and the check runs at the TB's ENTRY, so a smaller quantum
+ * could never be satisfied and that TB would re-exit at its own entry forever.
+ */
+void ot_insn_budget_enable(uint32_t quantum, void (*hook)(void));
+
+/*
+ * Guest instructions retired since the budget was armed.
+ *
+ * This is the only clock in the machine that is a function of GUEST PROGRESS
+ * rather than of the host, which makes it the right unit for anything that
+ * wants to say "N instructions from now" or "this has been waiting too long".
+ * Exact to the instruction: whole quanta plus however much of the current one
+ * the decrementer has already spent.
+ */
+uint64_t ot_insn_retired(void);
+
+#endif
