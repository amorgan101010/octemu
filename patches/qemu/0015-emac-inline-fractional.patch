target/m68k: inline fractional-mode EMAC

The Octatrack firmware keeps the EMAC in fractional mode: measured over a
boot-and-play run, ~99% of MAC accumulates were FI=1 (67% OMC with no
rounding, 12% OMC+RT, 11% non-saturating, 8% SU). Every one of them made
three helper calls (macmulf, mac_accum, mac_set_flags), and every
fractional `move.l %accN` a fourth (get_macf); together they were ~20% of
the TCG thread, which also runs both DSP cores, and that thread is the
bottleneck that keeps the emulator below real time.

The MACSR mode bits (OMC/SU/FI/RT) are already part of the TB flags, so a
block is translated for one mode and the inline code needs no runtime mode
tests. The accumulate and its flag update are fused into one sequence;
integer modes still go through the helpers.

Each inline sequence must stay bit-identical to the helper it replaces.
tests/emac-diff.py checks that against a reference build over random MAC
sequences in all 16 modes, and catches a planted tie-rounding error and a
planted latched-saturation error.

--- a/target/m68k/translate.c
+++ b/target/m68k/translate.c
@@ -5415,8 +5415,151 @@
 {
     tcg_gen_andi_i32(QREG_MACSR, QREG_MACSR,
                      ~(MACSR_V | MACSR_Z | MACSR_N | MACSR_EV));
+}
+
+/*
+ * Inline fractional-mode EMAC. The MACSR mode bits (OMC/SU/FI/RT) are part of
+ * the TB flags, so each block is translated for one mode and these need no
+ * runtime mode tests. Fractional mode is ~99% of the Octatrack's MAC traffic;
+ * the helper calls it replaces were ~20% of the TCG thread. Each function
+ * must stay bit-identical to the helper it replaces (helper.c).
+ */
+
+/* dst = src >> n (arithmetic), rounding the discarded bits half-to-even. */
+static void gen_mac_round_sar(TCGv_i64 dst, TCGv_i64 src, int n)
+{
+    TCGv_i64 rem = tcg_temp_new_i64();
+    TCGv_i64 gt = tcg_temp_new_i64();
+    TCGv_i64 eq = tcg_temp_new_i64();
+
+    tcg_gen_andi_i64(rem, src, (1ll << n) - 1);
+    tcg_gen_sari_i64(dst, src, n);
+    tcg_gen_setcondi_i64(TCG_COND_GTU, gt, rem, 1ll << (n - 1));
+    tcg_gen_setcondi_i64(TCG_COND_EQ, eq, rem, 1ll << (n - 1));
+    tcg_gen_and_i64(eq, eq, dst);             /* half: round up only if odd */
+    tcg_gen_or_i64(gt, gt, eq);
+    tcg_gen_andi_i64(gt, gt, 1);
+    tcg_gen_add_i64(dst, dst, gt);
+}
+
+/* helper_macmulf */
+static void gen_mac_mulf(DisasContext *s, TCGv_i64 dst, TCGv rx, TCGv ry)
+{
+    TCGv_i64 b = tcg_temp_new_i64();
+
+    tcg_gen_ext_i32_i64(dst, rx);
+    tcg_gen_ext_i32_i64(b, ry);
+    tcg_gen_mul_i64(dst, dst, b);
+    tcg_gen_shli_i64(dst, dst, 1);
+    if (s->env->macsr & MACSR_RT) {
+        gen_mac_round_sar(dst, dst, 24);
+    } else {
+        tcg_gen_sari_i64(dst, dst, 24);
+    }
+}
+
+/* helper_mac_accum followed by helper_mac_set_flags, fractional mode only. */
+static void gen_mac_accum_frac(DisasContext *s, int acc, TCGv_i64 val, bool sub)
+{
+    const bool omc = s->env->macsr & MACSR_OMC;
+    const uint32_t pav = MACSR_PAV0 << acc;
+    TCGv_i64 macc = MACREG(acc);
+    TCGv_i64 m = tcg_temp_new_i64();
+    TCGv_i64 v = tcg_temp_new_i64();
+    TCGv_i64 t = tcg_temp_new_i64();
+    TCGv flags = tcg_temp_new();
+    TCGv tmp = tcg_temp_new();
+
+    if (sub) {
+        tcg_gen_sub_i64(m, macc, val);
+    } else {
+        tcg_gen_add_i64(m, macc, val);
+    }
+    tcg_gen_shli_i64(m, m, 16);
+    tcg_gen_sari_i64(m, m, 16);               /* the 48-bit accumulator */
+    tcg_gen_sari_i64(v, m, 8);                /* its 1.31 value */
+    tcg_gen_ext32s_i64(t, v);
+    /* Overflow past signed 32 bits sets V and PAVn... */
+    tcg_gen_movcond_i64(TCG_COND_NE, t, v, t,
+                        tcg_constant_i64(MACSR_V | pav), tcg_constant_i64(0));
+    tcg_gen_extrl_i64_i32(flags, t);
+    if (omc) {
+        /* ...and with OMC clamps to the signed 32-bit limit. */
+        tcg_gen_movcond_i64(TCG_COND_LT, v, v, tcg_constant_i64(0),
+                            tcg_constant_i64(-0x80000000ll << 8),
+                            tcg_constant_i64(0x7fffffffll << 8));
+        tcg_gen_movcond_i64(TCG_COND_NE, m, t, tcg_constant_i64(0), v, m);
+        /* A latched PAVn leaves the accumulator alone and just sets V. */
+        tcg_gen_andi_i32(tmp, QREG_MACSR, pav);
+        tcg_gen_movcond_i32(TCG_COND_NE, flags, tmp, tcg_constant_i32(0),
+                            tcg_constant_i32(MACSR_V), flags);
+        tcg_gen_extu_i32_i64(t, tmp);
+        tcg_gen_movcond_i64(TCG_COND_NE, m, t, tcg_constant_i64(0), macc, m);
+    }
+    tcg_gen_or_i32(QREG_MACSR, QREG_MACSR, flags);
+    tcg_gen_mov_i64(macc, m);
+
+    /* helper_mac_set_flags: Z, N (bit 47), V from PAVn, EV past 40 bits. */
+    tcg_gen_setcondi_i64(TCG_COND_EQ, t, m, 0);
+    tcg_gen_extrl_i64_i32(flags, t);
+    tcg_gen_shli_i32(flags, flags, 2);        /* MACSR_Z */
+    tcg_gen_extract_i64(t, m, 47, 1);
+    tcg_gen_extrl_i64_i32(tmp, t);
+    tcg_gen_shli_i32(tmp, tmp, 3);            /* MACSR_N */
+    tcg_gen_or_i32(flags, flags, tmp);
+    tcg_gen_extract_i32(tmp, QREG_MACSR, 8 + acc, 1);
+    tcg_gen_shli_i32(tmp, tmp, 1);            /* MACSR_V */
+    tcg_gen_or_i32(flags, flags, tmp);
+    tcg_gen_sari_i64(t, m, 40);
+    tcg_gen_addi_i64(t, t, 1);
+    tcg_gen_setcondi_i64(TCG_COND_GTU, t, t, 1);   /* not 0 or -1: MACSR_EV */
+    tcg_gen_extrl_i64_i32(tmp, t);
+    tcg_gen_or_i32(flags, flags, tmp);
+    tcg_gen_or_i32(QREG_MACSR, QREG_MACSR, flags);
 }
 
+/* helper_get_macf */
+static void gen_mac_get_frac(DisasContext *s, TCGv rx, TCGv_i64 acc)
+{
+    const bool su = s->env->macsr & MACSR_SU;
+    TCGv_i64 v = tcg_temp_new_i64();
+    TCGv_i64 t = tcg_temp_new_i64();
+
+    tcg_gen_shli_i64(v, acc, 16);
+    tcg_gen_sari_i64(v, v, 16);
+    if (su) {
+        gen_mac_round_sar(v, v, 24);
+    } else if (s->env->macsr & MACSR_RT) {
+        gen_mac_round_sar(v, v, 8);
+    } else {
+        tcg_gen_sari_i64(v, v, 8);
+    }
+    if (s->env->macsr & MACSR_OMC) {
+        TCGv_i64 sat = tcg_temp_new_i64();
+
+        /* t = overflowed the store width; sat = the limit it clamps to */
+        if (su) {
+            tcg_gen_ext16s_i64(t, v);
+            tcg_gen_movcond_i64(TCG_COND_LT, sat, v, tcg_constant_i64(0),
+                                tcg_constant_i64(0x8000),
+                                tcg_constant_i64(0x7fff));
+        } else {
+            tcg_gen_ext32s_i64(t, v);
+            tcg_gen_movcond_i64(TCG_COND_LT, sat, v, tcg_constant_i64(0),
+                                tcg_constant_i64(0x80000000u),
+                                tcg_constant_i64(0x7fffffff));
+        }
+        tcg_gen_setcond_i64(TCG_COND_NE, t, v, t);
+        if (su) {
+            tcg_gen_andi_i64(v, v, 0xffff);
+        }
+        tcg_gen_movcond_i64(TCG_COND_NE, v, t, tcg_constant_i64(0), sat, v);
+    } else if (su) {
+        tcg_gen_andi_i64(v, v, 0xffff);
+    }
+    tcg_gen_extrl_i64_i32(rx, v);
+}
+
