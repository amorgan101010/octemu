util/osdep: skip redundant JIT execute toggles on macOS

cpu_tb_exec calls qemu_thread_jit_execute() on every entry into generated
code, and on Apple Silicon that is a pthread_jit_write_protect_np() call
every time. On the Octatrack board the guest instruction budget (0012)
returns to the exec loop constantly, so the toggle was ~4% of the vCPU
thread even though almost every call found the thread already in execute.

Cache the state in one thread-local flag. Only qemu_thread_jit_write() can
leave execute, and it clears the flag, so "cached execute, actually write"
cannot arise from QEMU. The DSP's asmjit runs on the same thread and toggles
the same state itself; its ProtectJitReadWriteScope always ends in execute,
and it only runs while generated code is executing, so the cache holds.

Measured unthrottled, interleaved: ahead in 5 of 5 rounds, ~+1.5 points of
real time.

--- a/include/qemu/osdep.h
+++ b/include/qemu/osdep.h
@@ -845,14 +845,29 @@
  * for the current thread.
  */
 #ifdef __APPLE__
+/*
+ * cpu_tb_exec asks for execute on every entry, and the toggle is not free
+ * (~4% of an Octatrack vCPU), but almost every call is already in execute.
+ * Only qemu_thread_jit_write can leave it, and that clears the cache, so the
+ * one unsafe state (cached execute, actually write) cannot arise from here.
+ * Other JITs on the thread (asmjit) must end every write in execute, as
+ * asmjit's ProtectJitReadWriteScope does. Defined in util/osdep.c: one
+ * variable, not a copy per translation unit.
+ */
+extern __thread bool qemu_thread_jit_is_exec;
+
 static inline void qemu_thread_jit_execute(void)
 {
-    pthread_jit_write_protect_np(true);
+    if (!qemu_thread_jit_is_exec) {
+        pthread_jit_write_protect_np(true);
+        qemu_thread_jit_is_exec = true;
+    }
 }
 
 static inline void qemu_thread_jit_write(void)
 {
     pthread_jit_write_protect_np(false);
+    qemu_thread_jit_is_exec = false;
 }
 #else
 static inline void qemu_thread_jit_write(void) {}
--- a/util/osdep.c
+++ b/util/osdep.c
@@ -30,6 +30,10 @@
 #include "qemu/mprotect.h"
 #include "qemu/hw-version.h"
 #include "monitor/monitor.h"
+
+#ifdef __APPLE__
+__thread bool qemu_thread_jit_is_exec;
+#endif
 
 int socket_set_cork(int fd, int v)
 {
