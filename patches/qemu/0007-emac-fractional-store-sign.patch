target/m68k: a fractional accumulator store is signed

MCF54455RM Table 5-3: the accumulator behind a fractional store is a SIGNED
48-bit quantity (the 1.31 value at bits 39:8). get_macf shifted and
overflow-tested it as unsigned, so with OMC set every NEGATIVE accumulator read
as an overflow — and the saturate value was then computed from the
already-shifted quantity, whose sign bit was gone, yielding zero. Positive
values passed through untouched, which half-wave rectifies any DSP routine that
reads samples back out of the accumulators.

Sign-extend the accumulator, round and shift arithmetically, and clamp to the
signed 16/32-bit bounds.

--- a/target/m68k/helper.c
+++ b/target/m68k/helper.c
@@ -1377,52 +1377,59 @@
     env->cc_op = CC_OP_FLAGS;
 }
 
+/*
+ * Fractional store: the accumulator is a SIGNED 48-bit quantity (the 1.31
+ * value at bits 39:8).  The shifts and the overflow test must be signed, or
+ * every negative accumulator reads back as an "overflow" whose saturate
+ * value has lost its sign bit -- i.e. zero.  MCF54455RM Table 5-3.
+ */
 uint32_t HELPER(get_macf)(CPUM68KState *env, uint64_t val)
 {
+    int64_t sval = ((int64_t)(val << 16)) >> 16;
     int rem;
     uint32_t result;
 
     if (env->macsr & MACSR_SU) {
         /* 16-bit rounding.  */
-        rem = val & 0xffffff;
-        val = (val >> 24) & 0xffffu;
+        rem = sval & 0xffffff;
+        sval >>= 24;
         if (rem > 0x800000)
-            val++;
+            sval++;
         else if (rem == 0x800000)
-            val += (val & 1);
+            sval += (sval & 1);
     } else if (env->macsr & MACSR_RT) {
         /* 32-bit rounding.  */
-        rem = val & 0xff;
-        val >>= 8;
+        rem = sval & 0xff;
+        sval >>= 8;
         if (rem > 0x80)
-            val++;
+            sval++;
         else if (rem == 0x80)
-            val += (val & 1);
+            sval += (sval & 1);
     } else {
         /* No rounding.  */
-        val >>= 8;
+        sval >>= 8;
     }
     if (env->macsr & MACSR_OMC) {
         /* Saturate.  */
         if (env->macsr & MACSR_SU) {
-            if (val != (uint16_t) val) {
-                result = ((val >> 63) ^ 0x7fff) & 0xffff;
+            if (sval != (int16_t)sval) {
+                result = sval < 0 ? 0x8000 : 0x7fff;
             } else {
-                result = val & 0xffff;
+                result = sval & 0xffff;
             }
         } else {
-            if (val != (uint32_t)val) {
-                result = ((uint32_t)(val >> 63) & 0x7fffffff);
+            if (sval != (int32_t)sval) {
+                result = sval < 0 ? 0x80000000u : 0x7fffffffu;
             } else {
-                result = (uint32_t)val;
+                result = (uint32_t)sval;
             }
         }
     } else {
         /* No saturation.  */
         if (env->macsr & MACSR_SU) {
-            result = val & 0xffff;
+            result = sval & 0xffff;
         } else {
-            result = (uint32_t)val;
+            result = (uint32_t)sval;
         }
     }
     return result;
