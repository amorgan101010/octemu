+/*
+ * Where an I/O access forced a TB to be split, and how many insns the TB at
+ * that pc may hold so the access is its LAST insn. Without this the TB stays
+ * cached and every pass pays for the split again: a longjmp, a host-pc lookup,
+ * an unwind and a 1-insn TB. A guest polling a device register in a loop hit
+ * that ~880k times a second. Only the vCPU thread touches this (one vCPU).
+ */
+static GHashTable *io_split_caps;
+
+static int io_split_cap(vaddr pc)
+{
+    gpointer cap;
+
+    if (io_split_caps &&
+        g_hash_table_lookup_extended(io_split_caps, (gpointer)(uintptr_t)pc,
+                                     NULL, &cap)) {
+        return GPOINTER_TO_INT(cap);
+    }
+    return TCG_MAX_INSNS;
+}
+
+static void io_split_remember(TranslationBlock *tb, uintptr_t retaddr)
+{
+    uint64_t data[INSN_START_WORDS];
+    int left, cap;
+
+    if ((tb_cflags(tb) & CF_COUNT_MASK) || !tb->icount) {
+        return;                     /* already a length-limited TB */
+    }
+    left = cpu_unwind_data_from_tb(tb, retaddr, data);
+    if (left <= 0) {
+        return;
+    }
+    cap = tb->icount - left + 1;    /* insns up to and including the access */
+    if (!io_split_caps) {
+        io_split_caps = g_hash_table_new(NULL, NULL);
+    }
+    if (cap < io_split_cap(tb->pc)) {
+        g_hash_table_insert(io_split_caps, (gpointer)(uintptr_t)tb->pc,
+                            GINT_TO_POINTER(cap));
+    }
+    /* Retranslate at the cap next time instead of splitting this one again. */
+    tb_phys_invalidate(tb, -1);
+}
+
 void cpu_io_recompile(CPUState *cpu, uintptr_t retaddr)
 {
     TranslationBlock *tb;
@@ -584,6 +637,7 @@
                   (void *)retaddr);
     }
