+/*
+ * MAC/MSAC accumulate with the RM's saturation semantics (MCF54455RM Table
+ * 5-2): overflow is judged and clamped at the SIGNED 32-BIT boundary (the
+ * fractional accumulator carries the 1.31 value at bits 39:8), not at the
+ * 48-bit accumulator width — and saturation LATCHES: while PAVn is set the
+ * accumulator ignores further MAC/MSAC until the flag is cleared or the
+ * accumulator is directly loaded. Caught by conformance vectors
+ * `saturate_positive` and `saturate_sticky`.
+ */
+void HELPER(mac_accum)(CPUM68KState *env, uint32_t acc, uint64_t val,
+                       uint32_t sub)
+{
+    int64_t sum, v, lo, hi;
+    int shift;
+
+    if ((env->macsr & MACSR_OMC) && (env->macsr & (MACSR_PAV0 << acc))) {
+        env->macsr |= MACSR_V;
+        return;
+    }
+    sum = env->macc[acc] + (sub ? -val : val);
+    env->macc[acc] = (sum << 16) >> 16;
+    if (!(env->macsr & (MACSR_FI | MACSR_SU))) {
+        /* Unsigned integer: 48-bit accumulator, clamps at its own width. */
+        uint64_t u = sum;
+        if (u & (0xffffull << 48)) {
+            env->macsr |= MACSR_V | (MACSR_PAV0 << acc);
+            if (env->macsr & MACSR_OMC) {
+                env->macc[acc] = u > (1ull << 53) ? 0 : (1ull << 48) - 1;
+            } else {
+                env->macc[acc] = u & ((1ull << 48) - 1);
+            }
+        }
+        return;
+    }
+    shift = (env->macsr & MACSR_FI) ? 8 : 0;
+    v = ((sum << 16) >> 16) >> shift;
+    lo = -0x80000000ll;
+    hi = 0x7fffffffll;
+    if (v < lo || v > hi) {
+        env->macsr |= MACSR_V | (MACSR_PAV0 << acc);
+        if (env->macsr & MACSR_OMC) {
+            env->macc[acc] = (v < 0 ? lo : hi) << shift;
+        }
+    }
 }
 
