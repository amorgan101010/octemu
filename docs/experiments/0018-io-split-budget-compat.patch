diff --git a/include/exec/ot-insn-budget.h b/include/exec/ot-insn-budget.h
index a3d3abb0b0..eaa4dc4f4e 100644
--- a/include/exec/ot-insn-budget.h
+++ b/include/exec/ot-insn-budget.h
@@ -69,4 +69,18 @@ uint64_t ot_insn_retired(void);
